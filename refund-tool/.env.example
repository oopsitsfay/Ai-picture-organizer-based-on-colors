# RPC endpoint for the chain the mint happened on.
# Use a paid/archive endpoint — public RPCs rate-limit hard on log queries.
RPC_URL=https://your-rpc-endpoint

# The wallet holding the funds, which will send the refunds.
REFUND_FROM=0x057b7c1d644464f4d0E11796Da092cAc59FA9386

# Only needed for `npm run send -- --execute` in sequential/disperse mode.
# Leave EMPTY if you are signing through a Safe / hardware wallet instead —
# build-plan.ts emits a Safe Transaction Builder CSV for that path.
# NEVER commit this file.
PRIVATE_KEY=

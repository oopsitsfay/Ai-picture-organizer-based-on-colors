# RPC endpoint for the chain the mint happened on.
#
# Robinhood Chain mainnet (chain id 4663, native currency ETH):
#   RPC_URL=https://rpc.mainnet.chain.robinhood.com
#
# That public endpoint is rate limited. Robinhood Chain has ~100ms block times, so
# even a few weeks of history is tens of millions of blocks and the indexer will
# make thousands of eth_getLogs calls. Use a dedicated provider endpoint for the
# indexing step if the public one throttles you.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The wallet holding the funds, which will send the refunds.
REFUND_FROM=0x057b7c1d644464f4d0E11796Da092cAc59FA9386

# Only needed for `npm run send -- --execute`.
# Leave EMPTY if you are signing through a Safe / hardware wallet instead —
# build-plan.ts emits a Safe Transaction Builder CSV for that path.
# NEVER commit this file. It is already in .gitignore.
PRIVATE_KEY=
